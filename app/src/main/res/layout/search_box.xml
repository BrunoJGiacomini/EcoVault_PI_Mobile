<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/txtSearchTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="O que você quer descartar hoje?"
        android:textColor="@color/muted_foreground"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/search_box_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search"
            app:tint="@color/muted_foreground"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="Ex: pilha AA, iPhone 7, lâmpada..."
            android:textColorHint="@color/muted_foreground"
            android:textColor="@color/foreground"
            android:textSize="15sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:inputType="text"
            android:singleLine="true"/>

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Buscar"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/btn_primary_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:minHeight="0dp"
            android:minWidth="0dp"/>

    </LinearLayout>
</LinearLayout>