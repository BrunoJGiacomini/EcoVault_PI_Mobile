<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="20dp"
    android:background="@drawable/gradient_hero"
    android:padding="20dp">

    <!-- EcoSaldo label -->
    <TextView
        android:id="@+id/txtEcoSaldoLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ECOSALDO"
        android:textColor="@color/primary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Pontos -->
    <TextView
        android:id="@+id/txtPoints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="1.240"
        android:textColor="@color/foreground"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtEcoSaldoLabel"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/txtPointsUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="pts"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/txtPoints"
        app:layout_constraintStart_toEndOf="@id/txtPoints"/>

    <!-- Equivalência em R$ -->
    <TextView
        android:id="@+id/txtEquivalente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="≈ R$ 12,40 em parceiros"
        android:textColor="@color/muted_foreground"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/txtPoints"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Badge streak -->
    <TextView
        android:id="@+id/txtStreak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 3 semanas"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/badge_streak_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Nível / progresso -->
    <TextView
        android:id="@+id/txtNivel"
        android:layout_width="121dp"
        android:layout_height="37dp"
        android:layout_marginTop="16dp"
        android:text="Eco-Herói · Nível 4"
        android:textColor="@color/muted_foreground"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtEquivalente" />

    <TextView
        android:id="@+id/txtProximoNivel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="65% → Guardião"
        android:textColor="@color/primary"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="@id/txtNivel"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/progressNivel"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="65"
        android:progressDrawable="@drawable/progress_gradient"
        app:layout_constraintTop_toBottomOf="@id/txtNivel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>