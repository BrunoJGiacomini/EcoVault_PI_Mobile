<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnVoltarAgendar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/primary"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Coleta em Casa"
            android:textColor="@color/foreground"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="40dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- HERO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/gradient_coleta"
                android:padding="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_coleta_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="LOGÍSTICA REVERSA · PNRS"
                    android:textColor="@color/coleta_badge_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A gente busca o seu eletrônico pesado"
                    android:textColor="@color/foreground"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TV, geladeira, computador, micro-ondas. Sem precisar carregar nada. Agendamento em 3 passos."
                    android:textColor="@color/muted_foreground"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/step_number_badge"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/coleta_badge_text"
                            android:textSize="11sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Escolha o que quer descartar"
                            android:textColor="@color/foreground"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/step_number_badge"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="@color/coleta_badge_text"
                            android:textSize="11sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Confirme endereço e data"
                            android:textColor="@color/foreground"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/step_number_badge"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="@color/coleta_badge_text"
                            android:textSize="11sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Aguarde — e ganhe pontos dobrados"
                            android:textColor="@color/foreground"
                            android:textSize="13sp"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- FORM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="O QUE VOCÊ VAI DESCARTAR?"
                    android:textColor="@color/muted_foreground"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:id="@+id/containerItensColeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ENDEREÇO DE COLETA"
                    android:textColor="@color/muted_foreground"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/edtEndereco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_bg"
                    android:padding="14dp"
                    android:hint="Av. Antônio Prado, 500"
                    android:textColorHint="@color/muted_foreground"
                    android:textColor="@color/foreground"
                    android:textSize="14sp"
                    android:inputType="textPostalAddress"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/edtComplemento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_bg"
                    android:padding="14dp"
                    android:hint="Complemento (apto, casa...)"
                    android:textColorHint="@color/muted_foreground"
                    android:textColor="@color/foreground"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DATA"
                            android:textColor="@color/muted_foreground"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:id="@+id/txtDataSelecionada"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/input_bg"
                            android:padding="14dp"
                            android:text="28/03/2026"
                            android:textColor="@color/foreground"
                            android:textSize="13.5sp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PERÍODO"
                            android:textColor="@color/muted_foreground"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp"/>

                        <Spinner
                            android:id="@+id/spinnerPeriodo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/input_bg"
                            android:padding="14dp"
                            android:minHeight="0dp"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- Bonus box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/info_banner_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="20dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/primary"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtBonusPontos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+240 pontos dobrados"
                            android:textColor="@color/foreground"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtBonusDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TV = 120pts × 2 por ser coleta em casa"
                            android:textColor="@color/muted_foreground"
                            android:textSize="11sp"/>
                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/btnConfirmarAgendamento"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/gradient_cta_button"
                    android:text="Confirmar agendamento"
                    android:textColor="@color/white"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>