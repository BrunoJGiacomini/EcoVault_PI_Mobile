<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toggleRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/item_toggle_bg_unselected"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/imgToggleIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        app:tint="@color/muted_foreground"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>

    <TextView
        android:id="@+id/txtToggleLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:text="Celular"
        android:textColor="@color/muted_foreground"
        android:textSize="12.5sp"/>

    <ImageView
        android:id="@+id/imgToggleCheck"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_check"
        app:tint="@color/primary"
        android:visibility="gone"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>

</LinearLayout>