<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guideCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/search_box_bg"
    android:padding="15dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <FrameLayout
        android:id="@+id/frameIconBg"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/icon_bg_red">

        <ImageView
            android:id="@+id/imgGuideIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_warning"
            app:tint="@color/destructive"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtGuideTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nunca quebre lâmpadas fluorescentes"
            android:textColor="@color/foreground"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtGuideDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Mercúrio tóxico é liberado no ar. Veja o descarte seguro."
            android:textColor="@color/muted_foreground"
            android:textSize="13sp"/>
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/muted_foreground"/>

</LinearLayout>