<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pillRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/pill_bg_inactive"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/imgPillIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        app:tint="@color/muted_foreground"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>

    <TextView
        android:id="@+id/txtPillLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilhas"
        android:textColor="@color/muted_foreground"
        android:textSize="13.5sp"
        android:textStyle="normal"/>

    <TextView
        android:id="@+id/txtPillPoints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="+30pts"
        android:textColor="@color/muted_foreground"
        android:textSize="11sp"/>

</LinearLayout>